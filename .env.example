# SQLite (local). For production on Vercel, switch Prisma to PostgreSQL
# and use a hosted database such as Neon or Vercel Postgres:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# Public site URL (no trailing slash). Required for Stripe redirects and signed links.
APP_URL="http://localhost:3000"

# Stripe — use Test mode keys while developing.
# Dashboard: https://dashboard.stripe.com/test/apikeys
# UK account recommended so settlement lands in your UK bank.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# Simple admin gate. Change both values before deploying.
ADMIN_PASSWORD="change-me-now"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# HMAC secret for time-limited download URLs.
DOWNLOAD_SECRET="replace-with-another-long-random-string"

# Directory for paid masters (outside /public). Relative to project root.
UPLOAD_DIR="uploads"

# When Stripe keys are placeholders, allow a local demo checkout that
# unlocks downloads without taking payment. Always false in production.
ALLOW_DEMO_CHECKOUT="true"
