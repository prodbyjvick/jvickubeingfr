# PostgreSQL — required. Use Neon’s *pooled* URL on Vercel (hostname contains `-pooler`).
# Pooled strings from Neon usually include `?sslmode=require`; keep that query param.
# For Prisma + Neon’s PgBouncer pooler, also add `pgbouncer=true`.
# On serverless, `connection_limit=1` avoids exhausting the pool.
#
# Placeholders only — never commit a real connection string.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) Neon URL — no `-pooler` in the hostname.
# Used by Prisma CLI (`db push`, migrate). Set to the same value as DATABASE_URL
# if you are on local Docker Postgres without a pooler.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Public site URL (no trailing slash). Required for Stripe redirects and signed links.
APP_URL="http://localhost:3000"

# Stripe — use Test mode keys while developing.
# Dashboard: https://dashboard.stripe.com/test/apikeys
# UK account recommended so settlement lands in your UK bank.
# Never take payment off Stripe (no PayPal links, bank-transfer invoices, or “DM for the file”).
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# Admin gate. Use 12+ characters. Change both values before deploying.
# Production rejects placeholders such as “change-me”.
ADMIN_PASSWORD="set-a-strong-local-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string-32chars"

# HMAC secret for time-limited download URLs (15 minutes).
DOWNLOAD_SECRET="replace-with-another-long-random-string"

# Directory for paid masters (outside /public). Relative to project root.
UPLOAD_DIR="uploads"

# Local-only: skip Stripe and unlock downloads. Forced off when NODE_ENV=production.
ALLOW_DEMO_CHECKOUT="false"
