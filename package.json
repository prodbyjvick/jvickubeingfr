    "db:bootstrap": "prisma db push && npm run db:seed",
    "media": "node scripts/generate-media.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
